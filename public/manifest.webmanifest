{
  "id": "/dashboard",
  "name": "Habitación Llena",
  "short_name": "Hab. Llena",
  "description": "PMS hotelero para operar recepción, reservas, habitaciones y ventas desde una sola app.",
  "lang": "es-AR",
  "dir": "ltr",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f6f7f9",
  "theme_color": "#ffffff",
  "orientation": "any",
  "prefer_related_applications": false,
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/pwa-icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/pwa-icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
