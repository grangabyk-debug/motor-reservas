{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --no-audit --no-fund",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "staging": true,
      "pms-rebuild-zero": true
    }
  }
}
